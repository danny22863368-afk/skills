# Telegram Bot 設定
# 從 @BotFather 申請 bot 後取得
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# 推播目標 chat id (個人 = 你的 user id, 群組 = 負數)
# 取得方式: 把 bot 加進群組或私訊後, 開啟 https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Nitter / RSSHub 來源 (擇一即可, 預設用 RSSHub 公開實例)
# 自架 Nitter:    https://nitter.example.com
# 公開 RSSHub:    https://rsshub.app
RSS_BASE_URL=https://rsshub.app

# 抓取設定
FETCH_LOOKBACK_HOURS=24
HTTP_TIMEOUT=20

# SQLite 路徑 (留空使用預設 data/news.db)
DB_PATH=
